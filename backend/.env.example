# ==============================================================================
# GEISER Helpdesk IA - Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# API & Core Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="ITSM Helpdesk API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-cryptographically-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL="http://localhost:5173"
RESET_TOKEN_EXPIRE_MINUTES=15

# ------------------------------------------------------------------------------
# MongoDB Database
# ------------------------------------------------------------------------------
MONGO_URL="mongodb://localhost:27017"
DATABASE_NAME="itsm_helpdesk"

# ------------------------------------------------------------------------------
# Rate Limiting (Distributed atomic MongoDB + Memory fallback)
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_2FA=5
RATE_LIMIT_2FA_WINDOW=60
RATE_LIMIT_PASSWORD_RESET=3
RATE_LIMIT_PASSWORD_RESET_WINDOW=60
RATE_LIMIT_AI=20
RATE_LIMIT_AI_WINDOW=60
RATE_LIMIT_GENERAL=100
RATE_LIMIT_GENERAL_WINDOW=60
TRUSTED_PROXIES="127.0.0.1,::1,testclient"

# ------------------------------------------------------------------------------
# Attachments & Uploads
# ------------------------------------------------------------------------------
MAX_ATTACHMENT_SIZE_MB=10

# ------------------------------------------------------------------------------
# Outbound Email (SMTP) & Notification Reliability
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="geiser.support@gmail.com"
SMTP_PASSWORD=""
FROM_EMAIL="geiser.support@gmail.com"
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=15
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_RETRY_INTERVAL_SECONDS=30
NOTIFICATION_WORKER_INTERVAL_SECONDS=30

# ------------------------------------------------------------------------------
# Inbound Email-to-Ticket (Gmail IMAP)
# ------------------------------------------------------------------------------
EMAIL_TO_TICKET_ENABLED=true
EMAIL_IMAP_HOST="imap.gmail.com"
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME="geiser.support@gmail.com"
EMAIL_IMAP_PASSWORD=""
EMAIL_IMAP_USE_SSL=true
EMAIL_IMAP_FOLDER="INBOX"
EMAIL_POLL_INTERVAL_SECONDS=60
EMAIL_MARK_AS_READ=true
EMAIL_MAX_MESSAGE_SIZE_MB=25
EMAIL_MAX_ATTACHMENT_MB=10
EMAIL_AUTO_PROVISION_USERS=true

# ------------------------------------------------------------------------------
# LDAP / Active Directory Integration
# ------------------------------------------------------------------------------
# Set to 'true' to enable enterprise directory authentication
LDAP_ENABLED=false

# LDAP / Active Directory Server endpoint:
# Examples: ldap://ad.geiser.internal:389  or  ldaps://ad.geiser.internal:636
LDAP_SERVER="ldap://localhost:389"
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_USE_TLS=false
LDAP_TIMEOUT=5

# Directory Base DN & Service Account Bind:
# Leave BIND_DN empty if directory allows anonymous user searches
LDAP_BASE_DN="dc=geiser,dc=internal"
LDAP_BIND_DN="cn=svc-helpdesk,ou=ServiceAccounts,dc=geiser,dc=internal"
LDAP_BIND_PASSWORD="replace-with-secure-bind-password"

# User search configuration:
LDAP_USER_SEARCH_BASE="ou=Users,dc=geiser,dc=internal"
LDAP_USER_SEARCH_FILTER="(&(objectClass=user)(|(sAMAccountName={username})(mail={username})))"
LDAP_GROUP_SEARCH_BASE="ou=Groups,dc=geiser,dc=internal"
LDAP_DEFAULT_ROLE="USER"

# TLS / Certificate Validation:
LDAP_TLS_CA_CERT_FILE=""
LDAP_TLS_VALIDATE_CERT=true

# RBAC Group-to-Role Mapping (Comma-separated CNs or group names):
LDAP_ROLE_GROUP_ADMIN="Helpdesk-Admins,Domain Admins"
LDAP_ROLE_GROUP_SUPERVISOR="Helpdesk-Supervisors"
LDAP_ROLE_GROUP_AGENT="Helpdesk-Agents,IT-Support"

# ------------------------------------------------------------------------------
# Local AI & RAG Engine (Ollama + FAISS)
# ------------------------------------------------------------------------------
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="gemma3:4b"
RAG_EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.30

# ------------------------------------------------------------------------------
# Twilio SMS Gateway
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_TEST_TO_NUMBER=""

# ------------------------------------------------------------------------------
# Automated Backups & Disaster Recovery (STEP 6)
# ------------------------------------------------------------------------------
BACKUP_ENABLED=true
# Storage directory for local backup archives (absolute or relative to backend/)
BACKUP_DIRECTORY="backups"
# Schedule in standard 5-part cron syntax (default: daily at 02:00 UTC)
BACKUP_SCHEDULE_CRON="0 2 * * *"
# Retention policy (defaults: 7 daily, 4 weekly, 3 monthly)
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=3
# Compression (gzip archive) and post-backup SHA-256 verification
BACKUP_COMPRESSION=true
BACKUP_VERIFY_INTEGRITY=true
# MongoDB target database to dump
BACKUP_MONGODB_DATABASE="itsm_helpdesk"
# Timeout per backup process execution in seconds
BACKUP_TIMEOUT_SECONDS=300
# Safety switch: strict safeguard preventing accidental production overwrites
BACKUP_ALLOW_PRODUCTION_RESTORE=false
# Optional binary path overrides (auto-discovered if left empty)
MONGODUMP_PATH=""
MONGORESTORE_PATH=""

