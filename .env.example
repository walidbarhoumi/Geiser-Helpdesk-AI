# ═══════════════════════════════════════════════════════════════════════════════
# GEISER Helpdesk AI — Environment Variable Reference
#
# Copy this file to backend/.env and fill in real values.
# NEVER commit .env to version control.
#
# Usage:
#   cp .env.example backend/.env
#   # edit backend/.env with your real credentials
#   docker compose up -d
# ═══════════════════════════════════════════════════════════════════════════════


# ── MongoDB ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (or local URI for development)
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name
# DATABASE_NAME=itsm_helpdesk   # default — override only if needed


# ── JWT / Authentication ─────────────────────────────────────────────────────
# MUST be changed in production. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
# RESET_TOKEN_EXPIRE_MINUTES=15


# ── Frontend ─────────────────────────────────────────────────────────────────
# URL the backend uses for password-reset links sent by email
FRONTEND_URL=http://localhost:80


# ── Email / SMTP (Gmail example) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-email@gmail.com
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false


# ── Inbound Email-to-Ticket (IMAP) ───────────────────────────────────────────
EMAIL_TO_TICKET_ENABLED=false
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=your-email@gmail.com
# EMAIL_IMAP_PASSWORD=   # defaults to SMTP_PASSWORD if not set
EMAIL_IMAP_USE_SSL=true
EMAIL_IMAP_FOLDER=INBOX
EMAIL_POLL_INTERVAL_SECONDS=60
EMAIL_MARK_AS_READ=true


# ── AI / Ollama ───────────────────────────────────────────────────────────────
# For Docker: use host.docker.internal to reach Ollama on the host machine,
# or http://ollama:11434 if using the --profile ollama Compose profile.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b


# ── RAG / FAISS Knowledge Base ────────────────────────────────────────────────
# RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# RAG_TOP_K=3
# RAG_SCORE_THRESHOLD=0.30


# ── Notifications / Twilio SMS ────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TEST_TO_NUMBER=
# NOTIFICATION_MAX_RETRIES=5
# NOTIFICATION_RETRY_INTERVAL_SECONDS=30
# NOTIFICATION_WORKER_INTERVAL_SECONDS=30


# ── SLA Monitoring ────────────────────────────────────────────────────────────
# SLA_SCAN_INTERVAL_MINUTES=2


# ── Automated Backups ─────────────────────────────────────────────────────────
BACKUP_ENABLED=true
# BACKUP_SCHEDULE_CRON=0 2 * * *
# BACKUP_RETENTION_DAYS=7
# BACKUP_RETENTION_WEEKLY=4
# BACKUP_RETENTION_MONTHLY=3


# ── LDAP / Active Directory (optional) ───────────────────────────────────────
LDAP_ENABLED=false
# LDAP_SERVER=ldap://your-ad-server:389
# LDAP_BASE_DN=dc=geiser,dc=internal
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=


# ── Rate Limiting ─────────────────────────────────────────────────────────────
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN=5
# RATE_LIMIT_LOGIN_WINDOW=60


# ── Docker Compose port overrides ─────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=80
